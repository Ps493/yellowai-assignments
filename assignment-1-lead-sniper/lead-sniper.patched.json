    {
      "id": "a1b2c3d4-0000-4000-8000-000000000021",
      "name": "Plan Pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Node: \"Plan Pages\"  (mode: Run Once for All Items)\n// GitHub lists stargazers oldest-first and has no \"since\" filter, so the newest\n// stars live on the LAST page. Read the star count, work out the last page, and\n// fetch it plus the one before it (a safety overlap for pages that just rolled over).\n\nconst PER_PAGE = 100;\nconst total = $input.first().json.stargazers_count ?? 0;\nconst lastPage = Math.max(1, Math.ceil(total / PER_PAGE));\nconst pages = lastPage > 1 ? [lastPage - 1, lastPage] : [1];\n\nreturn pages.map((page) => ({ json: { page, per_page: PER_PAGE, total } }));\n"
      }
    },
    {
      "id": "a1b2c3d4-0000-4000-8000-000000000022",
      "name": "Fetch Stargazer Pages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{ $('Config').first().json.repo_owner }}/{{ $('Config').first().json.repo_name }}/stargazers",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.star+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "per_page",
              "value": "={{ $json.per_page }}"
            },
            {
              "name": "page",
              "value": "={{ $json.page }}"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "2HjlH3QCASbJAxtV",
          "name": "GitHub Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "a1b2c3d4-0000-4000-8000-000000000023",
      "name": "Pick New Stargazers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1580,
        240
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Node: \"Pick New Stargazers\"  (mode: Run Once for All Items)\n// Keeps only stars we have not processed yet.\n//\n// Watermark = the newest `starred_at` handled so far, plus the logins already handled\n// AT that exact timestamp. Two people can star in the same second, so a plain \">\"\n// comparison could skip one of them when the per-run cap cuts between the two.\n// We use \">=\" and drop the logins we have already seen.\n//\n// - Oldest-first and capped per run, so whatever does not fit is picked up by the next poll.\n// - First run (no watermark): take only the latest N stars instead of flooding the\n//   channel with history. Manual test runs behave like this too, because n8n does\n//   not persist static data for manual executions.\n// - The watermark advances here, before delivery. A Discord failure after this point\n//   loses that lead (documented in LOGIC_LOG.md).\n\nconst cfg = $('Config').first().json;\nconst store = $getWorkflowStaticData('global');\n\nconst stars = $input\n  .all()\n  .map((item) => item.json)\n  .filter((s) => s && s.user && s.user.login && s.starred_at)\n  .sort((a, b) => (a.starred_at < b.starred_at ? -1 : a.starred_at > b.starred_at ? 1 : 0));\n\nconst mark = store.lastStarredAt;\nconst seen = new Set(store.seenAtMark ?? []);\n\nconst fresh = mark\n  ? stars.filter(\n      (s) => s.starred_at > mark || (s.starred_at === mark && !seen.has(s.user.login)),\n    )\n  : stars.slice(-Number(cfg.first_run_lookback));\n\nif (fresh.length === 0) return [];\n\nconst batch = fresh.slice(0, Number(cfg.max_per_run));\nconst newMark = batch[batch.length - 1].starred_at;\n\n// Logins handled at the new mark. If the mark did not move, keep the old ones too.\nconst atMark = batch.filter((s) => s.starred_at === newMark).map((s) => s.user.login);\nstore.seenAtMark = newMark === mark ? [...seen, ...atMark] : atMark;\nstore.lastStarredAt = newMark;\n\nreturn batch.map((s) => ({\n  json: {\n    login: s.user.login,\n    starred_at: s.starred_at,\n    repo: `${cfg.repo_owner}/${cfg.repo_name}`,\n  },\n}));\n"
      }
    },
