              "rightValue": "={{ $('Config').first().json.min_followers }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "a1b2c3d4-0000-4000-8000-000000000026",
              "leftValue": "={{ $json.public_repos ?? 0 }}",
              "rightValue": "={{ $('Config').first().json.min_public_repos }}",
              "operator": {
